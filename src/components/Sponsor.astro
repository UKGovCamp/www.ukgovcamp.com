---
import { Image } from "astro:assets";
const { image, name, title, link, maxHeight } = Astro.props;
---

<div class="sponsor">
    <a href={link}>{image ? <Image src={image} alt={name} title={name} style={maxHeight ? `max-height: ${maxHeight}` : undefined} /> : name}</a>
    {title && <span class="sponsor-title">{title}</span>}
</div>
