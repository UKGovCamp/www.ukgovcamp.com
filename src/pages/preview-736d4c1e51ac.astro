---
// Unlisted preview of a draft post. Not in the posts collection, so it stays
// off the home page, news page and feed. Delete once the post is published.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Author from "@/components/Author.astro";
import { getEntry } from "astro:content";
import { Content, frontmatter } from "../../drafts/october-updates-dates-tickets-and-becoming-a-non-profit.md";

const author = (await getEntry("authors", frontmatter.author))?.data ?? frontmatter.author;
---

<BaseLayout>
    <h2>{frontmatter.title}</h2>
    <p>
        Posted on {new Date(frontmatter.date).toLocaleDateString("en-GB")} by <Author
            author={author}
        />
    </p>
    <Content />
</BaseLayout>
